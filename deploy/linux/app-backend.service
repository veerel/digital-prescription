# systemd unit for the FastAPI backend (native Linux install).
# Install: sudo cp app-backend.service /etc/systemd/system/ && sudo systemctl enable --now app-backend
[Unit]
Description=Application backend (FastAPI)
After=network-online.target postgresql.service
Wants=network-online.target postgresql.service

[Service]
User=app
Group=app
WorkingDirectory=/opt/app/backend
EnvironmentFile=/etc/app/app.env
# Localhost only: Caddy is the only way in.
ExecStart=/opt/app/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=always
RestartSec=3

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
ReadOnlyPaths=/opt/app

[Install]
WantedBy=multi-user.target
