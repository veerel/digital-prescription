# Native Linux install (no Docker): LAN / offline HTTPS with Caddy's internal CA.
# Copy to /etc/caddy/Caddyfile and replace {$SITE_ADDRESS} (or set it in the caddy service environment).
# Client PCs must trust Caddy's root certificate once (see deploy/linux/README.md).
#
# SITE_ADDRESS is the LAN IP or internal hostname users type in the browser,
# e.g. 192.168.1.50 or app.client.local
{
	# Never try to reach Let's Encrypt or check for updates.
	auto_https disable_redirects
	skip_install_trust
}

(common) {
	encode zstd gzip

	handle /api/* {
		reverse_proxy 127.0.0.1:8000
	}

	handle {
		root * /opt/app/web
		try_files {path} /index.html
		file_server
	}

	header {
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; font-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		-Server
	}

	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@html path / /index.html
	header @html Cache-Control "no-cache"
}

{$SITE_ADDRESS} {
	tls internal
	import common
}

# Plain HTTP only redirects to HTTPS: session cookies are Secure and need it.
http://{$SITE_ADDRESS} {
	redir https://{host}{uri} permanent
}
