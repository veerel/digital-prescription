# Production settings. Copy to deploy/.env on the server and fill in.
# Never commit the real file.

APP_NAME=app
APP_VERSION=0.1.0

# cloud = public domain + Let's Encrypt; lan = internal CA, works fully offline
DEPLOY_MODE=lan
# What users type in the browser: a domain (cloud) or LAN IP / hostname (lan)
SITE_ADDRESS=192.168.1.50

# Generate each with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
POSTGRES_PASSWORD=
JWT_SECRET_KEY=
