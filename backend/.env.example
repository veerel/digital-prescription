# Copy to backend/.env and fill in real values. Never commit .env.
# Every setting here maps to a field in app/core/config.py.

ENVIRONMENT=development            # development | test | production

# PostgreSQL (psycopg 3 driver)
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/app
# Separate database used by the test suite. It is wiped by the tests.
TEST_DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/app_test

# JWT signing key. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-generate-a-long-random-value
JWT_ISSUER=digital-prescription
JWT_AUDIENCE=digital-prescription
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# Cookies. Secure cookies only travel over HTTPS (browsers allow them on
# http://localhost). Keep true everywhere except unusual local setups.
COOKIE_SECURE=true
COOKIE_SAMESITE=lax                # lax | strict
COOKIE_DOMAIN=                     # empty = host-only cookie (recommended)

# Only needed when the frontend is served from a different origin than the API.
# Comma-separated, e.g. https://app.example.com
CORS_ORIGINS=

# Brute-force protection
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# Clinic's local timezone (IANA name). Dashboard "today", visit-log date filters
# and follow-up dates are counted in this timezone.
CLINIC_TIMEZONE=Asia/Kolkata

# Serve /docs and /openapi.json (disable in production)
ENABLE_DOCS=true

LOG_LEVEL=INFO
